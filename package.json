{
  "name": "@openpmm/cli",
  "version": "0.2.0",
  "description": "First-party CLI for the OpenPMM public API",
  "type": "module",
  "bin": {
    "openpmm": "src/bin.js"
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenPMM/cli.git"
  },
  "homepage": "https://docs.openpmm.com/cli/overview",
  "bugs": {
    "url": "https://github.com/OpenPMM/cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack": "npm pack --dry-run",
    "check:api-coverage": "node scripts/check-api-coverage.js"
  }
}
